# Frontend configuration. No secrets belong here: everything prefixed VITE_ ends up in the browser.

# Leave empty (default): the app calls /api on its own origin and the frontend
# server proxies it to the backend. Set only to call a backend on another origin directly.
# Baked in at BUILD time.
# VITE_API_BASE_URL=https://backend.example.com

# Local development only: where the Vite dev server proxies /api (default http://localhost:8080)
# BACKEND_URL=http://localhost:8080
