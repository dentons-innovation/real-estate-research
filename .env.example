# n8n SSE webhook address. The production n8n cloud URL is the built-in
# default (src/config.ts), so this variable is only needed to OVERRIDE it —
# e.g. to test the frontend against the local mock server:
#   1. copy this file as .env.local
#   2. run: npm run mock
#   3. uncomment the line below
# VITE_N8N_SSE_WEBHOOK_URL=http://localhost:5678/webhook/research-sse
#
# NOTE: Vite bakes VITE_* variables in at BUILD time. On Railway set the
# variable in the service settings (if you need an override) and redeploy.
