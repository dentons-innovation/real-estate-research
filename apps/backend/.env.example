# Backend configuration. Copy to apps/backend/.env for local work (the file is gitignored).
# On Railway set these as variables of the backend service. Never commit real keys.

# --- Server ---------------------------------------------------------------
PORT=8080
# "::" listens on IPv4 and IPv6 (needed for Railway private networking)
HOST=::
LOG_LEVEL=info

# --- Access ---------------------------------------------------------------
# Shared password the team types into the app once per browser.
ACCESS_PASSWORD=
# Public origin(s) of the frontend, comma-separated. Needed only when the browser
# calls the backend directly; calls through the frontend proxy are same-origin.
CORS_ALLOWED_ORIGINS=

# --- Opoint (media monitoring) ---------------------------------------------
# Master switch. false: Opoint is never called, the "Opoint" switch in the app
# shows "unavailable due to a token limit", research runs on Tavily + AI only.
# true: a run uses Opoint when the user switches it on in the sidebar.
OPOINT_ENABLED=false
# Leave OPOINT_TOKEN empty to run on Tavily alone.
OPOINT_TOKEN=
OPOINT_STORED_SEARCH_ID=
OPOINT_BASE_URL=https://api.opoint.com
# auto | search_profile | feed | query   (auto: profile search, then feed)
OPOINT_MODE=auto
OPOINT_MAX_ARTICLES=300
# also run the generated boolean query next to the stored search
OPOINT_EXTRA_QUERY_ENABLED=false

# --- Tavily -----------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_DISCOVERY_QUERIES=48
TAVILY_CONCURRENCY=6

# --- Azure AI Foundry (GPT-5.6) ----------------------------------------------
# Resource URL, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name as created in Foundry
AZURE_OPENAI_DEPLOYMENT=
# responses (v1 Responses API) | chat (v1 Chat Completions) | azure-legacy (api-version URL)
AZURE_OPENAI_API_STYLE=responses
# only for azure-legacy, e.g. 2025-04-01-preview
AZURE_OPENAI_API_VERSION=
# low | medium | high | none
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=6000
LLM_CONCURRENCY=5
LLM_TIMEOUT_MS=120000

# --- Research tuning -----------------------------------------------------------
DEFAULT_RANGE_DAYS=30
MAX_RANGE_DAYS=90
MAX_ARTICLES_FOR_EXTRACTION=120
DEEPEN_LIMIT=15
MAX_QUERIES_PER_DEAL=4
MAX_NEW_SOURCES_PER_DEAL=4
DEEPEN_CONCURRENCY=3
# true: a deal without a date inside the window is dropped
STRICT_WINDOW=true
# a deal whose oldest report (stated date or source publication date) is older
# than this many days before the window end is dropped as stale
MAX_DEAL_AGE_DAYS=60
# extra source sites, comma-separated domains
EXTRA_TRADE_DOMAINS=
EXTRA_LAW_DOMAINS=

# --- Cost protection -------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=720000
DAILY_JOB_BUDGET=40

# --- Development -------------------------------------------------------------------
# true: fictional test data, no calls to Opoint / Tavily / Azure, no keys needed
MOCK_MODE=false
MOCK_SPEED=1
